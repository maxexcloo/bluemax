[Unit]
Description=Reims VM %i
After=dbus.service
Wants=dbus.service reims-awake@%i.service

[Service]
Type=forking
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/reims-ctl start %i
ExecStop=/usr/bin/reims-ctl stop %i
PIDFile=%h/.local/share/reims-ctl/vms/%i/qemu.pid
Restart=on-failure
RestartSec=5
TimeoutStopSec=210

[Install]
WantedBy=default.target
