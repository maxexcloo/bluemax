[Unit]
Description=Headless Moonlight streaming server
After=network-online.target

[Service]
ExecStart=/usr/bin/moonshine %h/.config/moonshine/config.toml
Environment=MOONSHINE_LOG=moonshine=info,moonshine_core=info,pixelforge=info
EnvironmentFile=-%h/.config/moonshine/environment
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
