[Unit]
Description=Private Capture Policy For Reims %i
After=reims-pipewire@%i.service
Requires=reims-pipewire@%i.service

[Service]
Environment=PIPEWIRE_REMOTE=pipewire-0
Environment=XDG_CONFIG_HOME=%h/.config/reims-stream/%i
Environment=XDG_RUNTIME_DIR=%t/reims-%i
Environment=XDG_STATE_HOME=%h/.local/state/reims-stream/%i
ExecStart=/usr/bin/wireplumber --profile policy
Restart=on-failure
RestartSec=5
