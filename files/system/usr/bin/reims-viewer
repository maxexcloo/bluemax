#!/usr/bin/env bash
set -euo pipefail

vm=${1:-mac}
host_audio="unix:${XDG_RUNTIME_DIR}/pulse/native"
module=
stream=
sink=
cleanup() {
    [[ -z "$stream" ]] || pactl --server="$host_audio" move-sink-input "$stream" "$sink" || true
    [[ -z "$module" ]] || pactl --server="$host_audio" unload-module "$module" || true
}
trap cleanup EXIT
trap "exit 0" INT TERM

# Route only this VM into Moonshine; restore its audio when the viewer closes.
if [[ -n "${PULSE_SERVER:-}" ]]; then
    pid=$(cat "$HOME/.local/share/reims-ctl/vms/$vm/qemu.pid")
    client=$(pactl --format=json --server="$host_audio" list clients |
        jq -r --arg pid "$pid" '.[] | select(.properties["application.process.id"] == $pid) | .index')
    if [[ -n "$client" ]]; then
        read -r stream sink < <(pactl --format=json --server="$host_audio" list sink-inputs |
            jq -r --arg client "$client" '.[] | select((.client | tostring) == $client) | "\(.index) \(.sink)"')
        module=$(pactl --server="$host_audio" load-module module-tunnel-sink \
            server="$PULSE_SERVER" sink_name="reims-$vm-stream" latency_msec=20)
        # PipeWire creates the tunnel sink asynchronously.
        for ((attempt = 0; attempt < 40; attempt++)); do
            if pactl --format=json --server="$host_audio" list sinks |
                jq -e --arg name "reims-$vm-stream" 'any(.[]; .name == $name)' >/dev/null; then
                pactl --server="$host_audio" move-sink-input "$stream" "reims-$vm-stream"
                break
            fi
            sleep 0.05
        done
    fi
fi

/usr/bin/vncviewer -AutoSelect=0 -FullColor -FullScreen -PreferredEncoding=Raw \
    -RemoteResize=0 -Shared 127.0.0.1:5901
